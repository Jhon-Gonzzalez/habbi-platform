{
    "name": "HABBI",

    // Imagen oficial de devcontainers con PHP 8.3 y Composer ya dentro.
    // No hace falta Node: el proyecto no tiene paso de compilación, el CSS
    // y el JS son archivos planos en public/assets.
    "image": "mcr.microsoft.com/devcontainers/php:8.3-bookworm",

    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "HABBI",
            "onAutoForward": "openPreview"
        }
    },

    // Se ejecuta una sola vez, al crear el Codespace.
    "postCreateCommand": "bash .devcontainer/preparar.sh",

    // Se ejecuta cada vez que te conectas: levanta el servidor.
    "postAttachCommand": "nohup php artisan serve --host=0.0.0.0 --port=8000 > storage/logs/serve.log 2>&1 &",

    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "onecentlin.laravel-blade",
                "amiralizadeh9480.laravel-extra-intellisense"
            ],
            "settings": {
                "files.eol": "\n"
            }
        }
    }
}
