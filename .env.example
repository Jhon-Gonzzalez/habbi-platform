# ==========================================================
#  HABBI — Variables de entorno
#  Copia este archivo a .env y rellena los valores reales.
#  El archivo .env NUNCA se sube al repositorio.
# ==========================================================

APP_NAME=HABBI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------- Base de datos (MySQL / MariaDB) ----------
# En cPanel el nombre lleva el prefijo de tu usuario: usuariocpanel_habbi
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=habbi
DB_USERNAME=root
DB_PASSWORD=

# ---------- Almacenamiento de fotos ----------
# 'public' guarda en storage/app/public y se sirve vía public/storage
FILESYSTEM_DISK=public

# ---------- Sesión y caché ----------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ---------- Correo ----------
# En cPanel: crea una cuenta en Email Accounts y usa esos datos.
# MAIL_HOST suele ser mail.TUDOMINIO.com
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Contacto público (pie de página) ----------
HABBI_CONTACT_EMAIL=
HABBI_COUNTRY=Colombia

# ---------- Administrador inicial ----------
# Lo usa: php artisan db:seed --class=AdminSeeder
ADMIN_NAME="Administrador HABBI"
ADMIN_EMAIL=
ADMIN_PASSWORD=
