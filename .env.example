# ==========================================================
#  HABBI — Variables de entorno
#  Copia este archivo a .env y rellena los valores reales.
#  El archivo .env NUNCA se sube al repositorio.
# ==========================================================

APP_NAME=HABBI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Proxies de confianza. Déjalo vacío salvo que la aplicación esté detrás de
# un proxy que tú controles y que termine el HTTPS (Codespaces, Cloudflare,
# un balanceador). En ese caso: TRUSTED_PROXIES=*
# Confiar en cualquiera permite falsear la IP de origen, y esa IP la guarda
# la auditoría.
TRUSTED_PROXIES=

APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------- Base de datos (MySQL / MariaDB) ----------
# En cPanel el nombre lleva el prefijo de tu usuario: usuariocpanel_habbi
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=habbi
DB_USERNAME=root
DB_PASSWORD=

# ---------- Almacenamiento de fotos ----------
# 'public' guarda en storage/app/public y se sirve vía public/storage
FILESYSTEM_DISK=public

# ---------- Sesión y caché ----------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ---------- Correo ----------
# En cPanel: crea una cuenta en Email Accounts y usa esos datos.
# MAIL_HOST suele ser mail.TUDOMINIO.com
# HABBI — VERIFICACIÓN DE CORREO
#
# false (por defecto): quien se registra queda verificado al instante y no
# se envía ningún correo. Así el proyecto funciona recién clonado, sin
# montar un servidor de correo. El código de verificación sigue entero.
#
# true: se exige correo verificado para reseñar, reportar y pedir ser
# arrendador. ENCIÉNDELO ANTES DE PUBLICAR con usuarios reales: sin esto,
# cualquiera se registra con un correo inventado las veces que quiera.
# Comprueba antes que el envío funciona:  php artisan habbi:correo
HABBI_VERIFICAR_CORREO=false

# HABBI — CORREO
#
# En local: "log". Los correos NO se envían; se escriben en
# storage/logs/laravel.log. Más cómodo todavía:
#     php artisan habbi:enlace tucorreo@gmail.com
#
# Para que lleguen de verdad a una bandeja, usa "smtp" y rellena lo de
# abajo. Con Gmail hace falta una «contraseña de aplicación» (no tu
# contraseña normal), y para eso tu cuenta de Google debe tener la
# verificación en dos pasos activada:
#     https://myaccount.google.com/apppasswords
#
#     MAIL_MAILER=smtp
#     MAIL_HOST=smtp.gmail.com
#     MAIL_PORT=587
#     MAIL_USERNAME=tucorreo@gmail.com
#     MAIL_PASSWORD=la-contraseña-de-aplicación-de-16-letras
#     MAIL_ENCRYPTION=tls
#     MAIL_FROM_ADDRESS=tucorreo@gmail.com
#
# Gmail limita el envío diario, así que sirve para probar pero no para una
# plataforma con muchos usuarios. Para eso, un servicio de correo
# transaccional (Brevo, Resend, Postmark) con su propio SMTP.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-responder@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Contacto público (pie de página) ----------
HABBI_CONTACT_EMAIL=
HABBI_COUNTRY=Colombia

# ---------- Administrador inicial ----------
# Lo usa: php artisan db:seed --class=AdminSeeder
ADMIN_NAME="Administrador HABBI"
ADMIN_EMAIL=
ADMIN_PASSWORD=
